   "source": [
    "rows=int(input(\"No of rows:\"))\n",
    "cols=int(input(\"No of columns:\"))\n",
    "A=np.zeros((rows,cols),dtype=int)\n",
    "for i in range(rows):\n",
    "    for j in range(cols):\n",
    "        A[i][j]=int(input(\"Enter element:\"))\n",
    "print(A)\n",
    "print(\"Rank of matrix: \",np.linalg.matrix_rank(A))"
   ]
